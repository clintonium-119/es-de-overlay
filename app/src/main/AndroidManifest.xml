<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The overlay service, which holds the screen capture; the capture type is only enforced from target 34. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- The service's notification with Open Menu, capture results, and the tap to start if a start after boot is refused. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The menu, guide viewer and browser over the game. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- System screenshots, filed under the game in front. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Game sound in clips: the capture's playback audio only, never the microphone. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Asks to keep the service running in the background. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Starts the service after a restart, when that setting is on. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Find Guides and the guide browser, only when the user opens them. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Which app is in front. The user grants it in Usage access, which Lint can't see, so it calls it protected. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Whether ES-DE is the Home app, which turns Screen off when idle on by default; whether Shizuku
         (or a fork, which keeps its package name) is installed, to open it from settings; and ES-DE itself,
         whose built-in themes the overlay reads from its app. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="org.es_de.frontend" />
    </queries>

    <!-- No backup or device transfer: the picked folders' grants don't survive one, and the browser's cookies stay here. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="ES-DE Overlay">

        <!-- Saved guides are read offline; WebView shouldn't report usage to Google either. -->
        <meta-data
            android:name="android.webkit.WebView.MetricsOptOut"
            android:value="true" />

        <!-- Exported as the launcher. The capture-consent extra only opens Android's own consent dialog. -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".GuidesActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <service
            android:name=".HelperService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|microphone" />

        <!-- Its own process, which ends when the viewer closes and takes the viewer's memory with it. -->
        <service
            android:name=".ViewerService"
            android:exported="false"
            android:process=":viewer" />

        <!-- Exported for Quick Settings, which alone holds the bind permission. -->
        <service
            android:name=".CaptureTile"
            android:exported="true"
            android:icon="@android:drawable/ic_menu_camera"
            android:label="ES-DE Overlay"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!-- Exported for Android's accessibility manager, which alone holds the bind permission. -->
        <service
            android:name=".ButtonService"
            android:exported="true"
            android:label="ES-DE Overlay"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/button_service" />
        </service>

        <!-- Receives Shizuku's binder, which Quit Game and leaving with Home end games through. Exported with the
             permission Shizuku's documentation gives, which only the system and the shell user hold. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- Exported for BOOT_COMPLETED, which only the system can send; it ignores any other action. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
