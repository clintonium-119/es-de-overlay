<theme>
    <include>./colors.xml</include>
    <include>./${system.theme}/colors.xml</include>
    <variables>
        <boldFont>./fonts/slate-bold.ttf</boldFont>
        <regularFont>./fonts/slate-regular.ttf</regularFont>
    </variables>
    <variant name="all">
        <view name="system, gamelist">
            <image name="background">
                <pos>0 0</pos>
                <size>1 1</size>
                <color>${backgroundColor}</color>
                <zIndex>0</zIndex>
            </image>
            <image name="shade">
                <size>1 1</size>
                <color>00000080</color>
                <zIndex>5</zIndex>
            </image>
            <image name="band">
                <size>0.03 1</size>
                <color>${bandColor}</color>
            </image>
        </view>
        <view name="gamelist">
            <image name="listFrame">
                <pos>0.02 0.19</pos>
                <size>0.4 0.72</size>
                <color>${frameColor}</color>
                <zIndex>10</zIndex>
            </image>
            <image name="infoFrame">
                <pos>0.44 0.19</pos>
                <size>0.54 0.72</size>
                <color>${frameColor}</color>
                <zIndex>10</zIndex>
            </image>
            <image name="glare">
                <pos>0 0.19</pos>
                <size>1 0.72</size>
                <color>FFFFFF20</color>
                <zIndex>60</zIndex>
            </image>
            <textlist name="gamelistTextlist">
                <selectorColor>${selectorColor}</selectorColor>
                <selectedColor>${selectedColor}</selectedColor>
                <primaryColor>${primaryColor}</primaryColor>
                <secondaryColor>${secondaryColor}</secondaryColor>
                <fontPath>${boldFont}</fontPath>
                <fontSize>0.04</fontSize>
                <lineSpacing>1.5</lineSpacing>
            </textlist>
            <text name="gameDescription">
                <metadata>description</metadata>
                <fontPath>${regularFont}</fontPath>
                <fontSize>0.03</fontSize>
                <lineSpacing>1.3</lineSpacing>
                <color>${primaryColor}</color>
            </text>
            <helpsystem name="help">
                <textColor>${primaryColor}</textColor>
                <iconColor>${selectorColor}</iconColor>
            </helpsystem>
        </view>
    </variant>
    <variant name="withVideos">
        <view name="gamelist">
            <image name="art">
                <imageType>miximage, screenshot</imageType>
                <cornerRadius>0.008</cornerRadius>
            </image>
        </view>
    </variant>
    <aspectRatio name="16:9">
        <include>./aspect-16-9.xml</include>
    </aspectRatio>
</theme>
